# ==============================================================================
# GASH BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

NODE_ENV=development
PORT=5000

# MongoDB Connection String (must NOT be localhost in production)
MONGO_URI=mongodb://127.0.0.1:27017/gash-backend

# JWT Configuration (In production: must be explicitly provided and >= 32 characters)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt Work Factor
BCRYPT_COST=12

# Frontend and CORS Origins (comma-separated list for ALLOWED_ORIGINS)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
